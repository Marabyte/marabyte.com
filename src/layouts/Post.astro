---
import { Image } from 'astro:assets';
import { formatDate } from '../lib/date';
import type { Post } from '../lib/posts';
import Base from './Base.astro';

interface Props {
	post: Post;
}

const { post } = Astro.props;
const { title, date, summary, featured_image } = post.data;
---

<Base title={title} description={summary} post={post}>
	<article class="article px-4 md:px-0 container mx-auto">
		<header class="mb-4">
			<figure>
				<Image class="object-cover h-64 w-full" src={featured_image.src} alt={featured_image.alt ?? ''} priority />
				{featured_image.caption && (
					<figcaption class="mx-auto max-w-3xl text-xs pt-2" set:html={featured_image.caption} />
				)}
			</figure>
			<time class="block mx-auto mt-8 max-w-3xl text-sm" datetime={date.toISOString()}>{formatDate(date)}</time>
			<h1 class="font-bold text-4xl mb-2 antialiased mx-auto max-w-3xl">{title}</h1>
		</header>
		<section class="leading-relaxed mx-auto max-w-3xl">
			<slot />
		</section>
	</article>
</Base>

<style is:global>
/* Global because it styles the rendered Markdown inside <slot />. */
.article {
	/*
	 * Space after each block of the post, and after the blocks inside quotes and figures
	 * (the -1em on video captions below relies on it). Images can sit inside a paragraph.
	 */
	section > *,
	section :where(blockquote, figure) > *,
	section img {
		margin-bottom: calc(1em + 0.5vw);
	}

	/*
	 * Underlined, not just coloured: the link colour is only ~2:1 against the body text,
	 * below the 3:1 that WCAG 1.4.1 needs for colour alone to mark a link.
	 */
	a {
		text-decoration-line: underline;
		text-underline-offset: 0.2em;
		&:hover {
			text-decoration-thickness: 2px;
		}
	}

	h2 {
		font-size: 1.5rem;
		line-height: 1.25;
		margin-top: 2.5em;
		a {
			color: var(--accent-color);
		}
	}

	h3 {
		font-size: 1.25rem;
		/* Bold makes 20px "large text", so the accent colour's 3.4:1 passes (normal weight needs 4.5:1). */
		font-weight: bold;
		margin-top: 2.5em;
	}

	hr {
		border-color: var(--accent-color);
	}

	blockquote {
		font-size: 1rem;
		padding-inline-start: 1em;
		font-style: italic;
		border-inline-start: 2px solid var(--accent-color);
	}

	iframe ~ figcaption {
		font-size: 1rem;
		text-align: center;
		margin-top: -1em;
	}

	:not(pre) > code {
		background: var(--code-background-color);
		color: var(--code-color);
		padding: 2px 4px;
	}

	/* Shiki sets the colours and scrolling; give the code room inside its block. */
	.astro-code {
		padding: 1em;
	}

	/*
	 * Tailwind's preflight sets `list-style: none` on lists, so the type goes back on the list
	 * itself (an `li { list-style: inside }` shorthand would also turn numbered lists into bullets).
	 */
	ul {
		list-style: disc inside;
	}

	ol {
		list-style: decimal inside;
	}

	li {
		margin-bottom: 0.5rem;
	}

	/* Tailwind v4's preflight zeroes this; v3 kept the browser default. */
	th,
	td {
		padding: 1px;
	}

	/* Wide tables scroll inside their own box (see the post's markup) instead of the page. */
	.table-scroll {
		overflow-x: auto;
	}

	table {
		width: 100%;
		caption {
			caption-side: bottom;
			font-size: 1rem;
			padding-top: 0.5em;
		}
		th,
		td {
			text-align: center;
		}
		thead,
		tr:not(:last-child) {
			border-bottom: 2px solid var(--accent-color);
		}
	}

	.video {
		aspect-ratio: 16 / 9;
		width: 100%;
	}
}
</style>
