---
import '../styles/global.css';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import type { Post } from '../lib/posts';
import { metadata } from '../lib/site';

interface Props {
	title?: string;
	description?: string;
	/** Set on blog posts: switches og:type to article and adds BlogPosting JSON-LD. */
	post?: Post;
	/** Path of the page this one duplicates, e.g. '/' for /posts/. Defaults to the current path. */
	canonicalPath?: string;
	/** Keep the page out of search results, and give it no canonical URL (e.g. the 404 page). */
	noindex?: boolean;
	/** Use the site name in the header as the page's <h1> (pages with no heading of their own). */
	siteNameAsHeading?: boolean;
}

const { title, description, post, canonicalPath, noindex = false, siteNameAsHeading = false } = Astro.props;
const pageTitle = title || metadata.title;
const pageDescription = description || metadata.description;
const absolute = (path: string) => new URL(path, Astro.site).href;
const pageUrl = absolute(canonicalPath ?? Astro.url.pathname);
const socialImage = post?.data.featured_image.social ?? metadata.image;
const image = absolute(socialImage.src);
const imageAlt = post?.data.featured_image.alt || metadata.imageAlt;

const jsonLd = post && {
	'@context': 'https://schema.org',
	'@type': 'BlogPosting',
	mainEntityOfPage: { '@type': 'WebPage', '@id': pageUrl },
	headline: post.data.title,
	image: [image],
	datePublished: post.data.date.toISOString(),
	dateModified: post.data.date.toISOString(),
	author: { '@type': 'Person', name: 'Hugo Nogueira', url: absolute('/about/') },
	publisher: {
		'@type': 'Organization',
		name: 'Marabyte',
		logo: { '@type': 'ImageObject', url: absolute(metadata.image.src) },
	},
	description: post.data.summary,
};
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8">
		<meta name="viewport" content="width=device-width, initial-scale=1.0">
		<meta name="color-scheme" content="dark">
		<meta name="theme-color" content="#222429">
		<title>{pageTitle}</title>
		{noindex ? <meta name="robots" content="noindex"> : <link rel="canonical" href={pageUrl}>}
		<link rel="preload" href="/assets/fonts/FiraMono-Regular.woff2" as="font" type="font/woff2" crossorigin>
		<link rel="alternate" type="application/atom+xml" title={metadata.title} href="/feed.xml">
		<meta name="twitter:card" content="summary_large_image">
		<meta name="twitter:creator" content="@marabyte_">
		{!noindex && <meta name="twitter:url" content={pageUrl}>}
		<meta name="twitter:title" content={pageTitle}>
		<meta name="twitter:description" content={pageDescription}>
		<meta name="twitter:image" content={image}>
		<meta name="twitter:image:alt" content={imageAlt}>
		<meta property="og:type" content={post ? 'article' : 'website'}>
		<meta property="og:image" content={image}>
		<meta property="og:title" content={pageTitle}>
		<meta property="og:description" content={pageDescription}>
		{!noindex && <meta property="og:url" content={pageUrl}>}
		<meta property="og:site_name" content="Home of the Marabyte">
		<meta property="og:image:width" content={socialImage.width}>
		<meta property="og:image:height" content={socialImage.height}>
		<meta property="og:image:alt" content={imageAlt}>
		<meta name="description" content={pageDescription}>
		{jsonLd && <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />}
		{/* hugavatar-180x180.png is really 280×280, so the sizes below follow the file, not its name. */}
		<link rel="apple-touch-icon" href="/assets/icons/hugavatar-180x180.png">
		<link rel="icon" type="image/png" sizes="280x280" href="/assets/icons/hugavatar-180x180.png">
		<link rel="icon" type="image/png" sizes="16x16" href="/assets/icons/hugavatar-16x16.png">
		<link rel="icon" type="image/png" sizes="32x32" href="/assets/icons/hugavatar-32x32.png">
		<link rel="icon" type="image/png" sizes="96x96" href="/assets/icons/hugavatar-96x96.png">
	</head>
	<body class="min-h-screen flex flex-col">
		<Header asHeading={siteNameAsHeading} />
		<main class="mb-20">
			<slot />
		</main>
		<Footer />
	</body>
</html>
