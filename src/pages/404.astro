---
import Base from '../layouts/Base.astro';
import { metadata } from '../lib/site';
---

<Base title={`Page not found | ${metadata.title}`} noindex>
	<section class="container mx-auto mt-16 px-4 md:w-1/2">
		<h1 class="text-2xl mb-4">Page not found</h1>
		<p>Sorry, there's nothing at this address. It may have moved, or never existed.</p>
		<p class="mt-4"><a href="/">Back to the home page</a></p>
	</section>
</Base>
