---
import { Image } from 'astro:assets';
import { type Post, postUrl } from '../lib/posts';

interface Props {
	post: Post;
	/** 1-based position in the grid; the first card spans two columns. */
	index: number;
}

const { post, index } = Astro.props;
const isFirst = index === 1;
---

<article class:list={['postcard relative flex flex-col aspect-square p-8', isFirst && 'sm:col-span-2 sm:aspect-[2/1]']}>
	{/* Decorative: the card's name comes from the title. object-left-top keeps the old background-image crop. */}
	<Image
		class="absolute inset-0 size-full object-cover object-left-top"
		src={post.data.featured_image.src}
		alt=""
		priority={isFirst}
	/>
	<a class="relative flex flex-1 flex-col justify-center" href={postUrl(post)}>
		<h2 class="font-bold sm:text-3xl text-2xl mt-auto antialiased">{post.data.title}</h2>
	</a>
</article>
