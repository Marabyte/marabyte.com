---
import { getImage } from 'astro:assets';
import { postUrl, type Post } from '../lib/posts';

interface Props {
  post: Post;
  /** 1-based position in the grid; the first card spans two columns. */
  index: number;
}

const { post, index } = Astro.props;
const gridType = index === 1 ? 'sm:col-span-2' : 'col-span-1';
const background = await getImage({ src: post.data.featured_image.src });
---
<article
  class:list={['postcard h-[100vw] sm:h-[50vw] lg:h-[calc(100vw/3)] xxl:h-[20vw] bg-cover p-8', gridType]}
  style={`background-image:url(${background.src})`}
>
  <a class="flex flex-col justify-center h-full" href={postUrl(post)}>
    <h2 class="font-bold sm:text-3xl text-2xl mt-auto antialiased">{post.data.title}</h2>
  </a>
</article>
