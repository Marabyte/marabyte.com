---
import Bluesky from './icons/Bluesky.astro';
import Github from './icons/Github.astro';
---

<footer class="footer container mx-auto mt-auto p-4 flex flex-col-reverse md:flex-row items-center">
	<small class="md:mr-auto">
		Marabyte | Built with
		<a href="https://astro.build/" target="_blank" rel="noreferrer">Astro</a>
		and hosted on
		<a href="https://www.cloudflare.com/" target="_blank" rel="noreferrer">Cloudflare</a>
	</small>
	<div class="flex mb-4 md:mb-0">
		<a class="ml-4" href="https://github.com/Marabyte" target="_blank" rel="noreferrer" aria-label="Hugo on GitHub">
			<Github />
		</a>
		<a
			class="ml-4"
			href="https://bsky.app/profile/marabyte.com"
			target="_blank"
			rel="noreferrer me"
			aria-label="Hugo on Bluesky"
		>
			<Bluesky />
		</a>
	</div>
</footer>

<style>
/* The SVGs live in child icon components, so they need :global(). */
.footer :global(svg) {
	height: 24px;
}
</style>
