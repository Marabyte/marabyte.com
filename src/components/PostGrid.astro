---
import { getPosts } from '../lib/posts';
import Card from './Card.astro';

const posts = (await getPosts()).reverse();
---

{/* biome-ignore lint/a11y/noRedundantRoles: Safari drops list semantics from a <ul> with no bullets, outside <nav>. */}
<ul role="list" class="mx-auto grid grid-cols-1 sm:grid-cols-2 lg:grid-cols-3 xxl:grid-cols-5">
	{posts.map((post, i) => <Card post={post} index={i + 1} />)}
</ul>
