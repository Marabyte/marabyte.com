---
import { metadata } from '../lib/site';
---

<header class="header flex container mx-auto items-center justify-between p-4">
	<h3>
		<a href="/">{metadata.title}</a>
	</h3>
	<nav>
		<ul class="flex items-center">
			<li><a href="/about/">About</a></li>
		</ul>
	</nav>
</header>

<style>
.header {
	li {
		margin: 0 10px;
		&:first-child {
			margin-left: 0;
		}
		&:last-child {
			margin-right: 0;
		}
	}
}
</style>
